<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>RAG Pipeline Simulator</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root {
      --bg: #050816;
      --bg-elevated: #0b1020;
      --accent: #6366f1;
      --accent-soft: rgba(99, 102, 241, 0.15);
      --accent-strong: #4f46e5;
      --text: #e5e7eb;
      --muted: #9ca3af;
      --border-subtle: #1f2933;
      --danger: #f97373;
      --success: #4ade80;
      --radius-lg: 14px;
      --radius-md: 10px;
      --radius-pill: 999px;
      --shadow-soft: 0 18px 45px rgba(0, 0, 0, 0.55);
      --shadow-chip: 0 10px 25px rgba(15, 23, 42, 0.7);
      --transition-fast: 0.18s ease-out;
      --transition-med: 0.25s ease-out;
      --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco,
        Consolas, "Liberation Mono", "Courier New", monospace;
      --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
        "Segoe UI", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: var(--font-sans);
      background: radial-gradient(circle at top, #111827 0, #020617 45%, #000 100%);
      color: var(--text);
      display: flex;
      align-items: stretch;
      justify-content: center;
      padding: 24px;
    }

    .app-shell {
      width: 100%;
      max-width: 1200px;
      background: linear-gradient(145deg, #020617 0%, #020617 40%, #020617 100%);
      border-radius: 24px;
      border: 1px solid rgba(148, 163, 184, 0.15);
      box-shadow: 0 30px 80px rgba(15, 23, 42, 0.9);
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.1fr);
      overflow: hidden;
      position: relative;
      isolation: isolate;
    }

    @media (max-width: 900px) {
      body {
        padding: 12px;
      }
      .app-shell {
        grid-template-columns: minmax(0, 1fr);
        border-radius: 18px;
      }
    }

    .app-shell::before {
      content: "";
      position: absolute;
      inset: -40%;
      background:
        radial-gradient(circle at 0% 0%, rgba(56, 189, 248, 0.08), transparent 55%),
        radial-gradient(circle at 100% 0%, rgba(129, 140, 248, 0.12), transparent 55%),
        radial-gradient(circle at 50% 100%, rgba(52, 211, 153, 0.08), transparent 55%);
      opacity: 0.9;
      z-index: -1;
    }

    .pane {
      padding: 22px 22px 20px;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .pane + .pane {
      border-left: 1px solid rgba(15, 23, 42, 0.9);
      background: radial-gradient(circle at top, rgba(15, 23, 42, 0.9), #020617);
    }

    @media (max-width: 900px) {
      .pane + .pane {
        border-left: none;
        border-top: 1px solid rgba(15, 23, 42, 0.9);
      }
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 4px;
    }

    .title-block {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .title {
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .title-pill {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      padding: 3px 9px;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(148, 163, 184, 0.35);
      color: var(--muted);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: radial-gradient(circle at top left, rgba(148, 163, 184, 0.18), transparent 60%);
    }

    .title-pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: radial-gradient(circle, #22c55e 0, #16a34a 40%, #052e16 100%);
      box-shadow: 0 0 12px rgba(34, 197, 94, 0.9);
    }

    .subtitle {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .step-indicator {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      color: var(--muted);
    }

    .step-badge {
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(148, 163, 184, 0.35);
      background: radial-gradient(circle at top, rgba(15, 23, 42, 0.9), #020617);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .step-badge span {
      font-weight: 500;
      color: #e5e7eb;
    }

    .step-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.7);
    }

    .step-dot.active {
      background: #6366f1;
      box-shadow: 0 0 10px rgba(99, 102, 241, 0.9);
    }

    .step-dot.done {
      background: #22c55e;
      box-shadow: 0 0 10px rgba(34, 197, 94, 0.9);
    }

    .section {
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.95), #020617);
      border-radius: var(--radius-lg);
      border: 1px solid rgba(31, 41, 55, 0.9);
      padding: 14px 14px 12px;
      box-shadow: var(--shadow-soft);
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      overflow: hidden;
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .section-title {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title span {
      color: #e5e7eb;
      font-weight: 600;
    }

    .section-chip {
      font-size: 0.7rem;
      padding: 3px 9px;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(148, 163, 184, 0.35);
      color: var(--muted);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: radial-gradient(circle at top right, rgba(15, 23, 42, 0.9), #020617);
    }

    .section-chip-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.7);
    }

    .section-chip-dot.ok {
      background: #22c55e;
    }

    .section-chip-dot.warn {
      background: #facc15;
    }

    .section-chip-dot.err {
      background: #f97373;
    }

    .section-body {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .row {
      display: flex;
      gap: 10px;
      align-items: stretch;
    }

    .row > * {
      flex: 1;
    }

    @media (max-width: 900px) {
      .row {
        flex-direction: column;
      }
    }

    textarea,
    input[type="text"] {
      width: 100%;
      border-radius: 10px;
      border: 1px solid rgba(55, 65, 81, 0.9);
      background: radial-gradient(circle at top left, #020617, #020617);
      color: var(--text);
      padding: 9px 10px;
      font-size: 0.8rem;
      resize: vertical;
      min-height: 70px;
      outline: none;
      transition: border-color var(--transition-fast), box-shadow var(--transition-fast),
        background var(--transition-fast), transform var(--transition-fast);
      font-family: var(--font-sans);
    }

    textarea:focus,
    input[type="text"]:focus {
      border-color: rgba(129, 140, 248, 0.9);
      box-shadow: 0 0 0 1px rgba(129, 140, 248, 0.6);
      background: radial-gradient(circle at top left, #020617, #020617);
      transform: translateY(-0.5px);
    }

    textarea::placeholder,
    input::placeholder {
      color: rgba(148, 163, 184, 0.7);
    }

    .small-label {
      font-size: 0.75rem;
      color: var(--muted);
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .small-label span {
      color: #e5e7eb;
      font-weight: 500;
    }

    .badge {
      font-size: 0.7rem;
      padding: 2px 8px;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(148, 163, 184, 0.4);
      color: var(--muted);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: radial-gradient(circle at top, rgba(15, 23, 42, 0.9), #020617);
    }

    .badge-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.7);
    }

    .badge-dot.good {
      background: #22c55e;
    }

    .badge-dot.info {
      background: #6366f1;
    }

    .badge-dot.warn {
      background: #facc15;
    }

    .badge-dot.err {
      background: #f97373;
    }

    .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }

    button {
      border-radius: var(--radius-pill);
      border: 1px solid rgba(148, 163, 184, 0.4);
      background: radial-gradient(circle at top left, rgba(79, 70, 229, 0.18), #020617);
      color: #e5e7eb;
      padding: 7px 14px;
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: background var(--transition-med), transform var(--transition-med),
        box-shadow var(--transition-med), border-color var(--transition-med);
      backdrop-filter: blur(10px);
    }

    button.primary {
      background: radial-gradient(circle at top left, #4f46e5, #312e81);
      border-color: rgba(191, 219, 254, 0.4);
      box-shadow: 0 14px 35px rgba(79, 70, 229, 0.6);
    }

    button.secondary {
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.9), #020617);
    }

    button.ghost {
      background: transparent;
      border-style: dashed;
      border-color: rgba(148, 163, 184, 0.5);
    }

    button:disabled {
      opacity: 0.5;
      cursor: default;
      box-shadow: none;
      transform: none;
    }

    button:not(:disabled):hover {
      transform: translateY(-1px) translateZ(0);
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.9);
      border-color: rgba(191, 219, 254, 0.7);
    }

    button.primary:not(:disabled):hover {
      box-shadow: 0 18px 45px rgba(79, 70, 229, 0.8);
    }

    button:active:not(:disabled) {
      transform: translateY(0);
      box-shadow: 0 10px 25px rgba(15, 23, 42, 0.9);
    }

    .btn-icon {
      width: 14px;
      height: 14px;
      border-radius: 999px;
      border: 1px solid rgba(191, 219, 254, 0.7);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.6rem;
      background: radial-gradient(circle, rgba(191, 219, 254, 0.2), transparent 60%);
    }

    .btn-icon-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: #22c55e;
      box-shadow: 0 0 10px rgba(34, 197, 94, 0.9);
    }

    .btn-icon-spark {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: conic-gradient(
        from 180deg,
        #f97316,
        #facc15,
        #22c55e,
        #22d3ee,
        #6366f1,
        #f97316
      );
      box-shadow: 0 0 12px rgba(129, 140, 248, 0.9);
    }

    .btn-icon-search {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      border: 1px solid rgba(191, 219, 254, 0.7);
      box-shadow: 0 0 10px rgba(129, 140, 248, 0.9);
    }

    .pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .pill {
      font-size: 0.7rem;
      padding: 3px 9px;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(55, 65, 81, 0.9);
      color: var(--muted);
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.9), #020617);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      box-shadow: var(--shadow-chip);
    }

    .pill strong {
      color: #e5e7eb;
      font-weight: 500;
    }

    .pill-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.7);
    }

    .pill-dot.emb {
      background: #22d3ee;
    }

    .pill-dot.chunk {
      background: #a855f7;
    }

    .pill-dot.vec {
      background: #6366f1;
    }

    .pill-dot.prompt {
      background: #22c55e;
    }

    .pill-dot.hall {
      background: #f97316;
    }

    .code-block {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      background: radial-gradient(circle at top left, #020617, #020617);
      border-radius: 10px;
      border: 1px solid rgba(31, 41, 55, 0.9);
      padding: 8px 9px;
      color: #e5e7eb;
      max-height: 160px;
      overflow: auto;
      line-height: 1.4;
      position: relative;
    }

    .code-block::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(15, 23, 42, 0.4), transparent 40%);
      pointer-events: none;
    }

    .code-line {
      white-space: pre-wrap;
      word-break: break-word;
    }

    .code-key {
      color: #a5b4fc;
    }

    .code-str {
      color: #fbbf24;
    }

    .code-num {
      color: #4ade80;
    }

    .code-comment {
      color: #6b7280;
      font-style: italic;
    }

    .status-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 0.72rem;
      color: var(--muted);
      margin-top: 2px;
    }

    .status-left,
    .status-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.7);
    }

    .status-dot.ok {
      background: #22c55e;
      box-shadow: 0 0 10px rgba(34, 197, 94, 0.9);
    }

    .status-dot.err {
      background: #f97373;
      box-shadow: 0 0 10px rgba(248, 113, 113, 0.9);
    }

    .status-dot.info {
      background: #6366f1;
      box-shadow: 0 0 10px rgba(99, 102, 241, 0.9);
    }

    .status-text-strong {
      color: #e5e7eb;
      font-weight: 500;
    }

    .log {
      font-size: 0.72rem;
      color: var(--muted);
      max-height: 120px;
      overflow: auto;
      padding: 6px 8px;
      border-radius: 10px;
      border: 1px dashed rgba(55, 65, 81, 0.9);
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.9), #020617);
    }

    .log-line {
      margin-bottom: 2px;
      display: flex;
      align-items: baseline;
      gap: 6px;
    }

    .log-tag {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: #9ca3af;
      min-width: 52px;
    }

    .log-msg {
      flex: 1;
    }

    .log-tag.ok {
      color: #4ade80;
    }

    .log-tag.warn {
      color: #facc15;
    }

    .log-tag.err {
      color: #f97373;
    }

    .log-tag.step {
      color: #60a5fa;
    }

    .highlight-chunk {
      border-radius: 8px;
      padding: 4px 6px;
      margin: 2px 0;
      background: radial-gradient(circle at top left, rgba(79, 70, 229, 0.18), transparent 70%);
      border: 1px solid rgba(79, 70, 229, 0.5);
    }

    .highlight-chunk strong {
      color: #e5e7eb;
    }

    .answer-block {
      font-size: 0.8rem;
      line-height: 1.5;
      color: #e5e7eb;
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.95), #020617);
      border-radius: 10px;
      border: 1px solid rgba(31, 41, 55, 0.9);
      padding: 9px 10px;
      max-height: 200px;
      overflow: auto;
    }

    .answer-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--muted);
      margin-bottom: 4px;
    }

    .answer-meta {
      font-size: 0.7rem;
      color: var(--muted);
      margin-top: 6px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .answer-meta span {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .answer-meta-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: #22c55e;
    }

    .chips-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 2px;
    }

    .chip {
      font-size: 0.7rem;
      padding: 2px 8px;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(55, 65, 81, 0.9);
      color: var(--muted);
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.9), #020617);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .chip-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.7);
    }

    .chip-dot.good {
      background: #22c55e;
    }

    .chip-dot.bad {
      background: #f97373;
    }

    .chip-dot.mid {
      background: #facc15;
    }

    .chip-dot.neu {
      background: #6366f1;
    }

    .slider-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.72rem;
      color: var(--muted);
    }

    input[type="range"] {
      flex: 1;
      -webkit-appearance: none;
      height: 4px;
      border-radius: 999px;
      background: linear-gradient(90deg, #22c55e, #6366f1);
      outline: none;
      cursor: pointer;
    }

    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 14px;
      height: 14px;
      border-radius: 999px;
      background: #e5e7eb;
      border: 2px solid #6366f1;
      box-shadow: 0 0 0 4px rgba(129, 140, 248, 0.4);
    }

    input[type="range"]::-moz-range-thumb {
      width: 14px;
      height: 14px;
      border-radius: 999px;
      background: #e5e7eb;
      border: 2px solid #6366f1;
      box-shadow: 0 0 0 4px rgba(129, 140, 248, 0.4);
    }

    .mini-tag {
      font-size: 0.7rem;
      padding: 2px 6px;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(55, 65, 81, 0.9);
      color: var(--muted);
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.9), #020617);
    }

    .fade {
      opacity: 0.4;
    }

    .pulse {
      animation: pulse 1.4s ease-in-out infinite;
    }

    @keyframes pulse {
      0% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(129, 140, 248, 0.6);
      }
      50% {
        transform: scale(1.02);
        box-shadow: 0 0 0 8px rgba(129, 140, 248, 0);
      }
      100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(129, 140, 248, 0);
      }
    }

    .hidden {
      display: none !important;
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <!-- LEFT: DOCUMENT → CHUNK → EMBEDDINGS → VECTOR DB -->
    <div class="pane">
      <div class="header">
        <div class="title-block">
          <div class="title">
            RAG Pipeline Simulator
            <span class="title-pill">
              <span class="title-pill-dot"></span>
              Conceptual, HTML‑only
            </span>
          </div>
          <div class="subtitle">
            Walk through: documents → chunks → embeddings → vector DB → retrieval → prompt → answer.
          </div>
        </div>
        <div class="step-indicator">
          <div class="step-badge">
            <span>Pipeline</span>
            <div class="step-dot done"></div>
            <div class="step-dot done"></div>
            <div class="step-dot"></div>
            <div class="step-dot"></div>
          </div>
        </div>
      </div>

      <!-- DOCUMENT INPUT -->
      <div class="section">
        <div class="section-header">
          <div class="section-title">
            <span>1. Documents</span>
          </div>
          <div class="section-chip">
            <div class="section-chip-dot ok"></div>
            Raw knowledge base
          </div>
        </div>
        <div class="section-body">
          <div class="small-label">
            <span>Paste your “corpus”</span>
            <span class="mini-tag">Multiple paragraphs = multiple topics</span>
          </div>
          <textarea
            id="docInput"
            placeholder="Example:
RAG (Retrieval-Augmented Generation) combines a vector search over external knowledge with an LLM to ground answers in retrieved context.

Embeddings map text into high-dimensional vectors where semantic similarity becomes geometric proximity.

Chunking splits long documents into smaller pieces so they fit in context windows and can be retrieved independently."
          ></textarea>
          <div class="btn-row">
            <button id="btnChunk" class="primary">
              <span class="btn-icon"><span class="btn-icon-dot"></span></span>
              Chunk & Embed
            </button>
            <button id="btnClear" class="secondary">
              <span class="btn-icon">×</span>
              Reset
            </button>
            <span class="badge">
              <span class="badge-dot info"></span>
              This simulator uses fake embeddings to show the flow, not real ML.
            </span>
          </div>
          <div class="status-bar">
            <div class="status-left">
              <div class="status-dot" id="docStatusDot"></div>
              <span id="docStatusText">Waiting for documents…</span>
            </div>
            <div class="status-right">
