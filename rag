  <script>
    // -----------------------------
    // Simple RAG simulator (no ML)
    // -----------------------------

    const docInput = document.getElementById("docInput");
    const docStatusDot = document.getElementById("docStatusDot");
    const docStatusText = document.getElementById("docStatusText");
    const docStats = document.getElementById("docStats");

    const chunkView = document.getElementById("chunkView");
    const embedView = document.getElementById("embedView");
    const vectorView = document.getElementById("vectorView");
    const vectorCount = document.getElementById("vectorCount");

    const queryInput = document.getElementById("queryInput");
    const queryEmbedView = document.getElementById("queryEmbedView");
    const retrievalView = document.getElementById("retrievalView");
    const retrievalStatusDot = document.getElementById("retrievalStatusDot");
    const retrievalStatusText = document.getElementById("retrievalStatusText");
    const retrievalStats = document.getElementById("retrievalStats");

    const promptView = document.getElementById("promptView");
    const answerView = document.getElementById("answerView");
    const answerMeta = document.getElementById("answerMeta");
    const logView = document.getElementById("logView");

    const btnChunk = document.getElementById("btnChunk");
    const btnClear = document.getElementById("btnClear");
    const btnRetrieve = document.getElementById("btnRetrieve");
    const btnRandomQuery = document.getElementById("btnRandomQuery");

    const topKSlider = document.getElementById("topKSlider");
    const topKLabel = document.getElementById("topKLabel");

    let vectorDB = []; // { id, text, embedding: [n] }
    let lastQueryEmbedding = null;
    let lastRetrieval = [];

    // Utility: log
    function log(tag, msg, type = "info") {
      const line = document.createElement("div");
      line.className = "log-line";
      const tagSpan = document.createElement("span");
      tagSpan.className = "log-tag " + (type === "ok" ? "ok" : type === "err" ? "err" : type === "step" ? "step" : "");
      tagSpan.textContent = `[${tag}]`;
      const msgSpan = document.createElement("span");
      msgSpan.className = "log-msg";
      msgSpan.textContent = msg;
      line.appendChild(tagSpan);
      line.appendChild(msgSpan);
      logView.appendChild(line);
      logView.scrollTop = logView.scrollHeight;
    }

    // Utility: fake embedding (4D vector)
    function fakeEmbedding(text) {
      // Deterministic-ish based on text hash
      let hash = 0;
      for (let i = 0; i < text.length; i++) {
        hash = (hash * 31 + text.charCodeAt(i)) >>> 0;
      }
      const vec = [];
      for (let i = 0; i < 4; i++) {
        const v = ((hash >> (i * 8)) & 0xff) / 255;
        vec.push(parseFloat((v * 2 - 1).toFixed(3))); // [-1, 1]
      }
      return vec;
    }

    // Utility: cosine similarity
    function cosineSim(a, b) {
      let dot = 0,
        na = 0,
        nb = 0;
      for (let i = 0; i < a.length; i++) {
        dot += a[i] * b[i];
        na += a[i] * a[i];
        nb += b[i] * b[i];
      }
      if (na === 0 || nb === 0) return 0;
      return dot / (Math.sqrt(na) * Math.sqrt(nb));
    }

    // Utility: pretty print vector
    function formatVec(v) {
      return "[" + v.map((x) => x.toFixed(3)).join(", ") + "]";
    }

    // Utility: escape HTML
    function esc(str) {
      return str.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));
    }

    // Update doc stats
    docInput.addEventListener("input", () => {
      const len = docInput.value.length;
      docStats.textContent = `${len} chars`;
      if (len > 0) {
        docStatusDot.classList.add("ok");
        docStatusText.textContent = "Documents ready. Click “Chunk & Embed”.";
      } else {
        docStatusDot.classList.remove("ok");
        docStatusText.textContent = "Waiting for documents…";
      }
    });

    // Chunk & Embed
    btnChunk.addEventListener("click", () => {
      const text = docInput.value.trim();
      if (!text) {
        alert("Paste some documents first.");
        return;
      }

      log("chunk", "Starting chunking + embedding pipeline…", "step");

      // Simple chunking: split by double newline, then by ~280 chars
      const paragraphs = text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
      const chunks = [];
      const maxLen = 280;

      paragraphs.forEach((p) => {
        if (p.length <= maxLen) {
          chunks.push(p);
        } else {
          let start = 0;
          while (start < p.length) {
            const slice = p.slice(start, start + maxLen);
            chunks.push(slice.trim());
            start += maxLen;
          }
        }
      });

      // Build vector DB
      vectorDB = [];
      chunks.forEach((chunk, idx) => {
        const emb = fakeEmbedding(chunk);
        vectorDB.push({
          id: idx + 1,
          text: chunk,
          embedding: emb,
        });
      });

      // Update chunk view
      chunkView.innerHTML = "";
      if (chunks.length === 0) {
        const line = document.createElement("div");
        line.className = "code-line code-comment";
        line.textContent = "// No chunks produced.";
        chunkView.appendChild(line);
      } else {
        chunks.forEach((chunk, i) => {
          const line = document.createElement("div");
          line.className = "code-line";
          line.innerHTML =
            '<span class="code-key">chunk_' +
            (i + 1) +
            "</span>: " +
            '<span class="code-str">"' +
            esc(chunk.slice(0, 120)) +
            (chunk.length > 120 ? "…" : "") +
            '"</span>';
          chunkView.appendChild(line);
        });
      }

      // Update embedding view
      embedView.innerHTML = "";
      vectorDB.forEach((entry) => {
        const line = document.createElement("div");
        line.className = "code-line";
        line.innerHTML =
          '<span class="code-key">emb_' +
          entry.id +
          "</span>: " +
          '<span class="code-num">' +
          esc(formatVec(entry.embedding)) +
          "</span>";
        embedView.appendChild(line);
      });

      // Update vector DB view
      vectorView.innerHTML = "";
      vectorDB.forEach((entry) => {
        const line = document.createElement("div");
        line.className = "code-line";
        line.innerHTML =
          "{ " +
          '<span class="code-key">id</span>: ' +
          '<span class="code-num">' +
          entry.id +
          "</span>, " +
          '<span class="code-key">len</span>: ' +
          '<span class="code-num">' +
          entry.text.length +
          "</span>, " +
          '<span class="code-key">embedding</span>: ' +
          '<span class="code-num">' +
          esc(formatVec(entry.embedding)) +
          "</span> }";
        vectorView.appendChild(line);
      });

      vectorCount.textContent = `${vectorDB.length} vectors`;
      docStatusDot.classList.add("ok");
      docStatusText.textContent = `Chunked into ${vectorDB.length} pieces. Ready for retrieval.`;

      retrievalView.innerHTML =
        '<div class="code-line code-comment">// Run retrieval to see top‑K chunks.</div>';
      queryEmbedView.innerHTML =
        '<div class="code-line code-comment">// Query embedding will appear here.</div>';
      promptView.innerHTML =
        '<div class="code-line code-comment">// Prompt will be constructed after retrieval.</div>';
      answerView.textContent =
        "The answer will be generated here using only the retrieved chunks, to mimic a grounded RAG response.";
      answerMeta.innerHTML =
        '<span><span class="answer-meta-dot"></span> Mode: grounded</span>' +
        '<span><span class="answer-meta-dot" style="background:#facc15;"></span> Hallucination risk: n/a</span>';

      retrievalStatusDot.classList.remove("ok", "err", "info");
      retrievalStatusText.textContent = "No retrieval yet.";
      retrievalStats.textContent = "Similarity: n/a";

      log("chunk", `Produced ${vectorDB.length} chunks and stored them in the vector DB.`, "ok");
    });

    // Clear
    btnClear.addEventListener("click", () => {
      docInput.value = "";
      docStats.textContent = "0 chars";
      docStatusDot.classList.remove("ok");
      docStatusText.textContent = "Waiting for documents…";

      vectorDB = [];
      vectorCount.textContent = "0 vectors";

      chunkView.innerHTML =
        '<div class="code-line code-comment">// Chunks will appear here after “Chunk & Embed”</div>';
      embedView.innerHTML =
        '<div class="code-line code-comment">// Each chunk gets a random 4‑dimensional vector to simulate embeddings</div>';
      vectorView.innerHTML =
        '<div class="code-line code-comment">// After embedding, each chunk is stored as: { id, text, embedding[] }</div>';

      queryInput.value = "";
      queryEmbedView.innerHTML =
        '<div class="code-line code-comment">// Will be generated when you run retrieval</div>';
      retrievalView.innerHTML =
        '<div class="code-line code-comment">// Retrieved chunks ranked by similarity will appear here</div>';
      retrievalStatusDot.classList.remove("ok", "err", "info");
      retrievalStatusText.textContent = "No retrieval yet.";
      retrievalStats.textContent = "Similarity: n/a";

      promptView.innerHTML =
        '<div class="code-line code-comment">// After retrieval, we’ll build a structured prompt with instructions + retrieved chunks + user query</div>';
      answerView.textContent =
        "The answer will be generated here using only the retrieved chunks, to mimic a grounded RAG response.";
      answerMeta.innerHTML =
        '<span><span class="answer-meta-dot"></span> Mode: grounded</span>' +
        '<span><span class="answer-meta-dot" style="background:#facc15;"></span> Hallucination risk: n/a</span>';

      log("reset", "Simulator state cleared.", "step");
    });

    // Top-K slider
    topKSlider.addEventListener("input", () => {
      topKLabel.textContent = `K = ${topKSlider.value}`;
    });

    // Random query
    const sampleQueries = [
      "Explain RAG in simple terms.",
      "Why do we need embeddings in RAG?",
      "How does chunking affect retrieval quality?",
      "What is the role of the vector database?",
      "How does RAG reduce hallucinations?"
    ];
    btnRandomQuery.addEventListener("click", () => {
      const q = sampleQueries[Math.floor(Math.random() * sampleQueries.length)];
      queryInput.value = q;
    });

    // Retrieval
    btnRetrieve.addEventListener("click", () => {
      if (vectorDB.length === 0) {
        alert("You need to chunk & embed documents first.");
        return;
      }
      const query = queryInput.value.trim();
      if (!query) {
        alert("Type a query first.");
        return;
      }

      log("retr", "Running similarity search over vector DB…", "step");

      // Fake query embedding
      const qEmb = fakeEmbedding(query);
      lastQueryEmbedding = qEmb;

      queryEmbedView.innerHTML = "";
      const qLine = document.createElement("div");
      qLine.className = "code-line";
      qLine.innerHTML =
        '<span class="code-key">query_emb</span>: ' +
        '<span class="code-num">' +
        esc(formatVec(qEmb)) +
        "</span>";
      queryEmbedView.appendChild(qLine);

      // Compute similarities
      const scored = vectorDB.map((entry) => {
        const sim = cosineSim(qEmb, entry.embedding);
        return { ...entry, sim };
      });

      scored.sort((a, b) => b.sim - a.sim);

      const k = Math.min(parseInt(topKSlider.value, 10), scored.length);
      const topK = scored.slice(0, k);
      lastRetrieval = topK;

      retrievalView.innerHTML = "";
      topK.forEach((entry, idx) => {
        const line = document.createElement("div");
        line.className = "code-line";
        const simStr = entry.sim.toFixed(3);
        line.innerHTML =
          '<span class="code-key">rank_' +
          (idx + 1) +
          "</span>: { " +
          '<span class="code-key">id</span>: ' +
          '<span class="code-num">' +
          entry.id +
          "</span>, " +
          '<span class="code-key">sim</span>: ' +
          '<span class="code-num">' +
          simStr +
          "</span>, " +
          '<span class="code-key">text</span>: ' +
          '<span class="code-str">"' +
          esc(entry.text.slice(0, 80)) +
          (entry.text.length > 80 ? "…" : "") +
          '"</span> }';
        retrievalView.appendChild(line);
      });

      const avgSim =
        topK.reduce((acc, e) => acc + e.sim, 0) / (topK.length || 1);
      retrievalStats.textContent = `Top‑K = ${k}, avg similarity ≈ ${avgSim.toFixed(3)}`;

      retrievalStatusDot.classList.remove("err");
      retrievalStatusDot.classList.add("info");
      retrievalStatusText.textContent = `Retrieved ${k} chunks ranked by cosine similarity.`;

      log(
        "retr",
        `Retrieved top‑${k} chunks. Best similarity ≈ ${topK[0].sim.toFixed(3)}.`,
        "ok"
      );

      // Build prompt
      buildPrompt(query, topK);

      // Generate answer
      generateAnswer(query, topK, avgSim);
    });

    // Build prompt (simulated)
    function buildPrompt(query, chunks) {
      promptView.innerHTML = "";

      const lines = [];

      lines.push(
        '<span class="code-comment">// System: You are a helpful assistant that must answer using ONLY the provided context.</span>'
      );
      lines.push(
        '<span class="code-key">SYSTEM</span>: <span class="code-str">"Answer concisely. If the answer is not in the context, say you don\'t know."</span>'
      );
      lines.push("");

      lines.push(
        '<span class="code-comment">// Retrieved context (top‑K chunks)</span>'
      );
      chunks.forEach((c, idx) => {
        lines.push(
          '<span class="code-key">CONTEXT_' +
            (idx + 1) +
            "</span>: " +
            '<span class="code-str">"' +
            esc(c.text) +
            '"</span>'
        );
      });

      lines.push("");
      lines.push(
        '<span class="code-comment">// User question</span>'
      );
      lines.push(
        '<span class="code-key">USER</span>: <span class="code-str">"' +
          esc(query) +
          '"</span>'
      );

      lines.forEach((html) => {
        const line = document.createElement("div");
        line.className = "code-line";
        line.innerHTML = html;
        promptView.appendChild(line);
      });

      log("prompt", "Constructed a prompt with system instructions + context + user query.", "step");
    }

    // Generate answer (simulated grounded answer)
    function generateAnswer(query, chunks, avgSim) {
      const qLower = query.toLowerCase();
      const answerParts = [];

      // Very rough heuristic: look for key concepts in chunks
      function contains(term) {
        return chunks.some((c) => c.text.toLowerCase().includes(term));
      }

      if (contains("retrieval-augmented generation") || contains("rag") || qLower.includes("rag")) {
        answerParts.push(
          "RAG (Retrieval‑Augmented Generation) is a pattern where an LLM is combined with a retrieval system over external knowledge."
        );
        answerParts.push(
          "Instead of relying only on its internal training, the model first retrieves relevant chunks from a vector database and then uses those chunks as context to answer the query."
        );
      }

      if (contains("embedding") || qLower.includes("embedding")) {
        answerParts.push(
          "Embeddings map text into high‑dimensional vectors so that semantically similar pieces of text are close together in that vector space."
        );
        answerParts.push(
          "In RAG, both the stored chunks and the user query are embedded, and similarity search over these vectors finds the most relevant chunks."
        );
      }

      if (contains("chunk") || qLower.includes("chunk")) {
        answerParts.push(
          "Chunking splits long documents into smaller pieces so they fit into the model’s context window and can be retrieved independently."
        );
      }

      if (contains("vector") || qLower.includes("vector database")) {
        answerParts.push(
          "A vector database stores the chunks along with their embeddings and supports efficient similarity search at query time."
        );
      }

      if (answerParts.length === 0) {
        answerParts.push(
          "Based on the retrieved context, I don’t have enough grounded information to confidently answer this question."
        );
        answerParts.push(
          "In a real RAG system, this is where you’d want better documents, better chunking, or improved retrieval."
        );
      }

      const answerText = answerParts.join(" ");

      answerView.innerHTML = "";
      const p = document.createElement("div");
      p.textContent = answerText;
      answerView.appendChild(p);

      // Show which chunks were used
      const used = document.createElement("div");
      used.style.marginTop = "8px";
      used.style.fontSize = "0.75rem";
      used.style.color = "#9ca3af";
      used.innerHTML = "Context used:";
      chunks.forEach((c, idx) => {
        const div = document.createElement("div");
        div.className = "highlight-chunk";
        div.innerHTML =
          "<strong>Chunk " +
          (idx + 1) +
          " (sim ≈ " +
          c.sim.toFixed(3) +
          "):</strong> " +
          esc(c.text.slice(0, 140)) +
          (c.text.length > 140 ? "…" : "");
        used.appendChild(div);
      });
      answerView.appendChild(used);

      // Update meta
      const risk =
        avgSim >= 0.6 ? "low" : avgSim >= 0.3 ? "medium" : "high";
      const riskColor =
        avgSim >= 0.6 ? "#22c55e" : avgSim >= 0.3 ? "#facc15" : "#f97373";

      answerMeta.innerHTML =
        '<span><span class="answer-meta-dot"></span> Mode: grounded (simulated)</span>' +
        `<span><span class="answer-meta-dot" style="background:${riskColor};"></span> Hallucination risk: ${risk}</span>`;

      log(
        "answer",
        `Generated a grounded answer using ${chunks.length} retrieved chunks (avg similarity ≈ ${avgSim.toFixed(
          3
        )}).`,
        "ok"
      );
    }
  </script>
</body>
</html>
