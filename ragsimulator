<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>RAG Pipeline Simulator</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root {
      --bg: #050816;
      --bg-elevated: #0b1020;
      --accent: #6366f1;
      --accent-soft: rgba(99, 102, 241, 0.15);
      --accent-strong: #4f46e5;
      --text: #e5e7eb;
      --muted: #9ca3af;
      --border-subtle: #1f2933;
      --danger: #f97373;
      --success: #4ade80;
      --radius-lg: 14px;
      --radius-md: 10px;
      --radius-pill: 999px;
      --shadow-soft: 0 18px 45px rgba(0, 0, 0, 0.55);
      --shadow-chip: 0 10px 25px rgba(15, 23, 42, 0.7);
      --transition-fast: 0.18s ease-out;
      --transition-med: 0.25s ease-out;
      --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco,
        Consolas, "Liberation Mono", "Courier New", monospace;
      --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
        "Segoe UI", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: var(--font-sans);
      background: radial-gradient(circle at top, #111827 0, #020617 45%, #000 100%);
      color: var(--text);
      display: flex;
      align-items: stretch;
      justify-content: center;
      padding: 24px;
    }

    .app-shell {
      width: 100%;
      max-width: 1200px;
      background: linear-gradient(145deg, #020617 0%, #020617 40%, #020617 100%);
      border-radius: 24px;
      border: 1px solid rgba(148, 163, 184, 0.15);
      box-shadow: 0 30px 80px rgba(15, 23, 42, 0.9);
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.1fr);
      overflow: hidden;
      position: relative;
      isolation: isolate;
    }

    @media (max-width: 900px) {
      body {
        padding: 12px;
      }
      .app-shell {
        grid-template-columns: minmax(0, 1fr);
        border-radius: 18px;
      }
    }

    .app-shell::before {
      content: "";
      position: absolute;
      inset: -40%;
      background:
        radial-gradient(circle at 0% 0%, rgba(56, 189, 248, 0.08), transparent 55%),
        radial-gradient(circle at 100% 0%, rgba(129, 140, 248, 0.12), transparent 55%),
        radial-gradient(circle at 50% 100%, rgba(52, 211, 153, 0.08), transparent 55%);
      opacity: 0.9;
      z-index: -1;
    }

    .pane {
      padding: 22px 22px 20px;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .pane + .pane {
      border-left: 1px solid rgba(15, 23, 42, 0.9);
      background: radial-gradient(circle at top, rgba(15, 23, 42, 0.9), #020617);
    }

    @media (max-width: 900px) {
      .pane + .pane {
        border-left: none;
        border-top: 1px solid rgba(15, 23, 42, 0.9);
      }
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 4px;
    }

    .title-block {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .title {
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .title-pill {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      padding: 3px 9px;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(148, 163, 184, 0.35);
      color: var(--muted);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: radial-gradient(circle at top left, rgba(148, 163, 184, 0.18), transparent 60%);
    }

    .title-pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: radial-gradient(circle, #22c55e 0, #16a34a 40%, #052e16 100%);
      box-shadow: 0 0 12px rgba(34, 197, 94, 0.9);
    }

    .subtitle {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .step-indicator {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      color: var(--muted);
    }

    .step-badge {
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(148, 163, 184, 0.35);
      background: radial-gradient(circle at top, rgba(15, 23, 42, 0.9), #020617);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .step-badge span {
      font-weight: 500;
      color: #e5e7eb;
    }

    .step-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.7);
    }

    .step-dot.active {
      background: #6366f1;
      box-shadow: 0 0 10px rgba(99, 102, 241, 0.9);
    }

    .step-dot.done {
      background: #22c55e;
      box-shadow: 0 0 10px rgba(34, 197, 94, 0.9);
    }

    .section {
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.95), #020617);
      border-radius: var(--radius-lg);
      border: 1px solid rgba(31, 41, 55, 0.9);
      padding: 14px 14px 12px;
      box-shadow: var(--shadow-soft);
      display
